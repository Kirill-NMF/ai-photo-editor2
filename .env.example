NODE_ENV=development
HOST=127.0.0.1
PORT=5080
PUBLIC_BASE_URL=http://127.0.0.1:5080

DATABASE_URL=postgresql://photoeditor:change-me@127.0.0.1:5432/photoeditor
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (set all three values or leave all three empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: https://ai-photo-editor.store/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Telegram Login Widget (set both values or leave both empty)
TELEGRAM_BOT_TOKEN=
# Example: ai_photo_editor_auth_bot
TELEGRAM_BOT_USERNAME=

# Private Beget S3-compatible storage
S3_ENDPOINT=
# Use the region shown in the Beget S3 bucket settings.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The only supported AI provider
GEMINI_API_KEY=

# Optional one-use-per-account code that resets the monthly edit counter
PROMO_CODE=
