NODE_ENV=development
HOST=127.0.0.1
PORT=5080
PUBLIC_BASE_URL=http://127.0.0.1:5080

DATABASE_URL=postgresql://photoeditor:change-me@127.0.0.1:5432/photoeditor
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (set all three values or leave all three empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://127.0.0.1:5080/api/auth/google/callback
# Production: https://ai-photo-editor.store/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Telegram Login Widget (set both values or leave both empty)
TELEGRAM_BOT_TOKEN=
# Example: ai_photo_editor_auth_bot
TELEGRAM_BOT_USERNAME=

# Local private image storage. Use an absolute path in production.
LOCAL_STORAGE_DIR=./data/object-storage
# 15 GiB; new uploads are rejected at the limit and files are never auto-deleted.
LOCAL_STORAGE_LIMIT_BYTES=16106127360

# OpenRouter image editing with google/gemini-2.5-flash-image (Nano Banana)
OPENROUTER_API_KEY=

# Optional one-use-per-account code that resets the monthly edit counter
PROMO_CODE=
